# Copy this file to .env and fill in your values

# ── LLM (OpenCode Go) ────────────────────────────────
OPENCODE_API_KEY=

# ── Database (PostgreSQL) ────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── Google OAuth (Gmail read-only) ───────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
# Optional: where the OAuth token is stored (defaults to backend/token.json)
GMAIL_TOKEN_PATH=token.json

# ── LangSmith tracing (optional) ─────────────────────
# Each processed email is recorded in LangSmith as one trace (run name
# "Email: <subject>", tag "email-processor"). Leave LANGSMITH_TRACING unset or
# false to disable. The legacy LANGCHAIN_TRACING_V2 / LANGCHAIN_API_KEY names
# also work.
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mailtrace
